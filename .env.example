# ==============================================================================
# Jamie & Brady Residential OS — environment
# ==============================================================================
# Copy to `.env.local` and fill in what you have. The application runs with NONE
# of these set: it falls back to seeded demo data and a deterministic AI
# provider, and every screen says which parts are mocked.
#
# Never commit a filled-in copy of this file. Everything here is server-side
# except the two NEXT_PUBLIC_ values.
# ==============================================================================

# ------------------------------------------------------------------ Supabase
# Setting these two switches the whole application over at once: data moves from
# in-memory demo storage to Postgres, AND authentication moves from the shared
# passcode to Supabase Auth. Removing them switches everything back — that is
# the rollback.
#
# Do not set them until `npm run db:verify` passes against the project.
#
# Dashboard -> Project Settings -> API.
# Browser-safe: these two are sent to the browser by design, and are useless
# without a valid session because row level security gates every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Bypasses row level security entirely — it is the master key to
# every client record. Never put it in a NEXT_PUBLIC_ variable, never paste it
# into a chat or a ticket, never commit it. Used only by the command-line
# scripts (db:seed, db:verify, team:*), never by the running app.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------ Anthropic
# Without a key, AI surfaces render deterministic templates built from your own
# data. Useful, but not the finished product.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=

# ---------------------------------------------------------------------- Cloze
# The CRM system of record. Settings -> Integrations -> API in Cloze.
CLOZE_API_KEY=
CLOZE_USER_EMAIL=
# Optional overrides.
CLOZE_API_URL=
# Optional: route Cloze through an MCP server instead of REST. See the README.
CLOZE_MCP_URL=

# ------------------------------------------------------ Google (Gmail + Calendar)
# One OAuth client covers both. Scopes needed:
#   gmail.readonly, gmail.compose, calendar.readonly, calendar.events
# Note: gmail.compose permits creating drafts AND sending. This app never sends
# mail — that is enforced by application code, not by the scope.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ----------------------------------------------------------------- ActivePipe
# Read-only. ActivePipe keeps running database nurture; this reads engagement
# signals to decide who deserves a personal call.
ACTIVEPIPE_API_KEY=

# --------------------------------------------------------------------- Zapier
# Optional alternative transport for Gmail/Cloze if you would rather not build
# an OAuth flow. See the README.
ZAPIER_MCP_URL=

# ------------------------------------------------------------------ Unlock MLS
# Requires a signed data licence. Nothing in this codebase scrapes a portal.
# MLS_PROVIDER: mlsgrid | trestle | bridge   (only "mock" is implemented today)
MLS_PROVIDER=mock
MLS_API_URL=
MLS_API_KEY=

# ------------------------------------------------------------------- DocuSign
# Planned. Contract status on the transaction timeline.
DOCUSIGN_INTEGRATION_KEY=

# ------------------------------------------------------------------------ Auth
# Used only when Supabase Auth is not configured. This is a shared passcode
# gate for demos — connect Supabase before putting real client data in.
DEMO_PASSCODE=residential
# Signs the demo session cookie. REQUIRED in production — the app refuses to
# issue or accept a demo session without it rather than falling back to a
# guessable key. Outside production a random per-process key is generated, so
# local sessions simply do not survive a restart.
# Generate with: openssl rand -base64 32
SESSION_SECRET=
